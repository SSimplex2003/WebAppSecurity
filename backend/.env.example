# Optional: every setting has a working default, so you can run without a .env file.
# Copy to .env only to override something. Never commit the real .env file.

# Defaults to a local SQLite file (backend/data/vault.db). To use PostgreSQL
# (see docker-compose.yml), uncomment:
# DATABASE_URL=postgresql+psycopg2://vault:vault@localhost:5432/vault

# Defaults to in-memory sessions (lost on restart, single process). To keep
# sessions in Redis instead, uncomment:
# REDIS_URL=redis://localhost:6379/0

# Keep true. Only set to false for plain-HTTP experiments (it renames the
# session cookie from __Host-sid to sid and drops the Secure flag).
# COOKIE_SECURE=true

# Session lifetime in seconds: idle timeout and absolute maximum.
# SESSION_IDLE_SECONDS=900
# SESSION_ABSOLUTE_SECONDS=43200

# Send Strict-Transport-Security. Leave off on localhost: browsers remember
# HSTS per hostname (not per port) and would then force https on every
# localhost project.
# ENABLE_HSTS=false
