# Copy to .env and fill in for local development.
# Never commit the real .env file.

PORT=3000
NODE_ENV=development

# postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://vault:vault@localhost:5432/vault

REDIS_URL=redis://localhost:6379

# Long random value used to sign the session cookie (see docs/checkpoint-1-design.md).
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-before-deploying
